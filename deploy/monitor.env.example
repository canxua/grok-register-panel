MONITOR_HOST=127.0.0.1
MONITOR_PORT=8787
MONITOR_TOKEN=replace-with-a-long-random-token
PANEL_INCLUDE_TAIL=0
CPA_AUTH_DIR=/opt/grok-register-panel/cpa_auth
# Keep disabled until a one-account canary is explicitly scheduled.
CPA_AUTO_VERIFY=0
CPA_REMOTE_URL=http://127.0.0.1:8317
CPA_CONTROLLER_URL=http://127.0.0.1:9000
CPA_DATA_PLANE_URL=https://api.example.com
CPA_DATA_PLANE_MODEL=MODEL
# Store these only in this mode-0600 file, or load an additional systemd
# EnvironmentFile owned by root.
CPA_MANAGEMENT_KEY=replace-with-management-key
CPA_CONTROLLER_TOKEN=replace-with-controller-ops-token
CPA_DATA_PLANE_KEY=replace-with-data-plane-key
